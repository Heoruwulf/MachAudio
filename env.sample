# MachAudio Environment Variable Configuration
# Rename this file to .env or source it to configure the MachAudio server globally.
# Command-line arguments will override these environment variables.

# Core mask for CPU pinning of workers. Supports hexadecimal (e.g., 0x15) or CSV (e.g., 0,2,4)
# Default: 0
# MACH_CORE_MASK="0"

# Set the SCHED_FIFO real-time priority for the server threads (1-99)
# Default: -1 (Real-time priority disabled)
# MACH_RT_PRIORITY="50"

# The TCP host IP address to listen on. If set, this activates TCP mode instead of UDS (Unix Domain Sockets).
# Default: unset (Unix Domain Sockets used instead)
# MACH_HOST="127.0.0.1"

# The base TCP port for workers to bind to when TCP mode is active (MACH_HOST is set).
# Default: 8000
# MACH_PORT="8000"

# The directory where the Unix Domain Sockets will be created (if TCP mode is not used).
# Default: /tmp
# MACH_UDS_DIR="/tmp"

# The maximum open file descriptors limit (RLIMIT_NOFILE) the server will attempt to acquire.
# Default: 4096
# MACH_FD_LIMIT="4096"

# Absolute or relative path to a custom VAD training data binary file to load on startup.
# Overrides the built-in VAD dataset. 
# Default: unset (uses the built-in dataset)
# MACH_VAD_DATA="./assets/vad_training_data.f32"
